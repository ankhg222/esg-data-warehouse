  <Source dwd:design-time-name="21f48a0a-92c1-439b-b55b-3f1372bdf8d9">
    <DataSourceViewID>DW_TRAIN_DSV</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="dc2f858c-4399-4a37-a2ae-20caaf54b67b">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE; 

CREATE MEMBER CURRENTCUBE.[Measures].[CO2 Intensity (lb per MWh)]
 AS IIF(
  [Measures].[Net Generation (MWh)] = 0,
  NULL,
  ([Measures].[CO2 Emissions (Tons)] * 2000) / [Measures].[Net Generation (MWh)]
), 
FORMAT_STRING = '#,##0.00', 
VISIBLE = 1; 

CREATE MEMBER CURRENTCUBE.[Measures].[Revenue per MWh Sold]
 AS IIF(
  [Measures].[Sales (MWh)] = 0,
  NULL,
  [Measures].[Revenue (K USD)] * 1000 / [Measures].[Sales (MWh)]
), 
FORMAT_STRING = '$#,##0.000', 
VISIBLE = 1; 

CREATE MEMBER CURRENTCUBE.[Measures].[Revenue per Customer]
 AS IIF(
  [Measures].[Customer Count] = 0,
  NULL,
  [Measures].[Revenue (K USD)] * 1000 / [Measures].[Customer Count]
), 
FORMAT_STRING = '$#,##0.00', 
VISIBLE = 1; 

CREATE MEMBER CURRENTCUBE.[Measures].[Total GHG Equivalent (CO2e tons)]
 AS [Measures].[CO2 Emissions (Tons)]
+ ([Measures].[CH4 Emissions (Tons)] * 25)
+ ([Measures].[N2O Emissions (Tons)] * 298), 
FORMAT_STRING = '#,##0', 
VISIBLE = 1; 

CREATE MEMBER CURRENTCUBE.[Measures].[Renewable Share]
 AS IIF(
  [Measures].[Net Generation (MWh)] = 0,
  NULL,
  (
    ([Dim Fuel].[Is Renewable].&amp;[1], [Measures].[Net Generation (MWh)])
    / [Measures].[Net Generation (MWh)]
  ) * 100
), 
FORMAT_STRING = '0.00%', 
VISIBLE = 1;</Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
  <Kpis>
    <Kpi dwd:design-time-name="7db0c582-2d65-4d5e-8e10-ad42f638333a">
      <ID>KPI</ID>
      <Name>CO2 Intensity KPI</Name>
      <AssociatedMeasureGroupID>Fact Plant Annual</AssociatedMeasureGroupID>
      <Value>[Measures].[CO2 Intensity (lb per MWh)]</Value>
      <Goal>800</Goal>
      <Status>IIF([Measures].[CO2 Intensity (lb per MWh)] &lt;= 400, 1, IIF([Measures].[CO2 Intensity (lb per MWh)] &lt;= 800, 0, -1))
</Status>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="456c3bd6-2f00-45ac-af5a-7207a8bf85ce">
