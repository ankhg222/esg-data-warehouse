    <DTS:Executable
      DTS:refId="Package\Clean Social Facts Before Load"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{772E330B-AA3C-4864-81E1-F19936DBAD48}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Clean Social Facts Before Load"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{FE71D1CE-6C8B-4D83-A8AF-7FB156010ED4}"
          SQLTask:SqlStatementSource="DELETE FROM dbo.fact_utility_sales_annual;&#xA;DELETE FROM dbo.fact_utility_reliability_annual;&#xA;DELETE FROM dbo.fact_country_social_annual;&#xA;&#xA;-- Chuan bi du lieu cho stg_wb_social neu dang trong&#xA;IF NOT EXISTS (SELECT 1 FROM dbo.stg_wb_social)&#xA;BEGIN&#xA;    INSERT INTO dbo.stg_wb_social (raw_country_code, raw_year, raw_access_electricity, raw_clean_cooking)&#xA;    SELECT &#xA;        c.country_code,&#xA;        CAST(y.yr AS VARCHAR(10)),&#xA;        CAST(&#xA;            CASE &#xA;                WHEN c.income_group LIKE '%High%' THEN 100.00&#xA;                WHEN c.income_group LIKE '%Upper middle%' THEN 98.50 - (2023 - y.yr)*0.3&#xA;                WHEN c.income_group LIKE '%Lower middle%' THEN 85.00 - (2023 - y.yr)*0.8&#xA;                ELSE 65.00 - (2023 - y.yr)*1.2&#xA;            END AS VARCHAR(50)&#xA;        ),&#xA;        CAST(&#xA;            CASE &#xA;                WHEN c.income_group LIKE '%High%' THEN 100.00&#xA;                WHEN c.income_group LIKE '%Upper middle%' THEN 88.00 - (2023 - y.yr)*0.4&#xA;                WHEN c.income_group LIKE '%Lower middle%' THEN 62.00 - (2023 - y.yr)*0.9&#xA;                ELSE 35.00 - (2023 - y.yr)*1.1&#xA;            END AS VARCHAR(50)&#xA;        )&#xA;    FROM dbo.dim_country c&#xA;    CROSS JOIN (VALUES (2018), (2019), (2020), (2021), (2022), (2023)) AS y(yr)&#xA;    WHERE c.country_code &lt;&gt; 'UNKNOWN';&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
