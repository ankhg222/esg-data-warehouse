              description="OLE DB Source"
              name="SRC - stg_eia861_sales Aggregated"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    TRY_CAST(s.raw_year AS INT) * 10000 + 101 AS year_key,
    u.utility_key,
    st.state_key,
    sec.sector_key,
    SUM(TRY_CAST(s.raw_revenue_kusd AS DECIMAL(18,2))) AS revenue_kusd,
    SUM(TRY_CAST(s.raw_sales_mwh AS DECIMAL(18,2))) AS sales_mwh,
    SUM(TRY_CAST(s.raw_customer_count AS INT)) AS customer_count
FROM dbo.stg_eia861_sales s
INNER JOIN dbo.dim_utility u 
    ON TRY_CAST(s.raw_utility_id AS INT) = u.eia_utility_id 
    AND u.is_current = 1
INNER JOIN dbo.dim_state st 
    ON s.raw_state = st.state_code
INNER JOIN dbo.dim_customer_sector sec 
    ON s.raw_sector_code = sec.sector_code
WHERE TRY_CAST(s.raw_year AS INT) IS NOT NULL
GROUP BY 
    TRY_CAST(s.raw_year AS INT) * 10000 + 101,
    u.utility_key,
    st.state_key,
    sec.sector_key;</property>
