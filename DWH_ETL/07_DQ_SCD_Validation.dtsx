    <DTS:PrecedenceConstraint
      DTS:refId="Package.PrecedenceConstraints[Constraint 2]"
      DTS:CreationName=""
      DTS:DTSID="{8359AFDE-4AE3-4213-B495-5536FFC2CC80}"
      DTS:From="Package\DQ - Check match bridge fact_company_env"
      DTS:LogicalAnd="True"
      DTS:ObjectName="Constraint 2"
      DTS:To="Package\DQ - Validate ownership bridge_plant_company" />
  </DTS:PrecedenceConstraints>
