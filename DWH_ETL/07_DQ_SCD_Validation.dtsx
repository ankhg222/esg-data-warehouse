  <DTS:Variables />
  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\DQ - Check fact_ba_hourly"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{BAA7495A-41E9-490F-9E7B-2CF8FC85A58A}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="DQ - Check fact_ba_hourly"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F329DA15-93EA-4CC8-9BA8-C7F4616BC505}"
          SQLTask:SqlStatementSource="-- ĐỐI SOÁT DÒNG VÀ KIỂM TRA BẤT THƯỜNG&#xA;DECLARE @stg_cnt INT, @fact_cnt INT, @neg_cnt INT;&#xA;&#xA;SELECT @stg_cnt = COUNT(*) &#xA;FROM dbo.stg_eia930_hourly &#xA;WHERE NULLIF(LTRIM(RTRIM(raw_ba_code)), '') IS NOT NULL &#xA;  AND TRY_CAST(raw_datetime_utc AS DATETIME) IS NOT NULL;&#xA;&#xA;SELECT @fact_cnt = COUNT(*) FROM dbo.fact_ba_hourly;&#xA;&#xA;SELECT @neg_cnt = COUNT(*) &#xA;FROM dbo.fact_ba_hourly &#xA;WHERE demand_mw &lt; 0 OR co2_emissions_generated &lt; 0 OR co2_emissions_consumed &lt; 0;&#xA;&#xA;IF @neg_cnt &gt; 0&#xA;    PRINT 'CẢNH BÁO: Phát hiện dòng có giá trị âm bất thường!';&#xA;ELSE&#xA;    PRINT 'PASSED: fact_ba_hourly hợp lệ.';" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\DQ - Check match bridge fact_company_env"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{B07A3F33-95DD-4001-863C-65F9A3E39B4A}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="DQ - Check match bridge fact_company_env"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F329DA15-93EA-4CC8-9BA8-C7F4616BC505}"
          SQLTask:SqlStatementSource="-- KIỂM TRA TOÀN VẸN BRIDGE: Phát hiện dòng mồ côi (không có trong Bridge)&#xA;DECLARE @orphan_cnt INT;&#xA;&#xA;SELECT @orphan_cnt = COUNT(*)&#xA;FROM dbo.fact_company_environment_annual f&#xA;LEFT JOIN dbo.bridge_plant_company b &#xA;    ON f.company_key = b.company_key &#xA;   AND f.year_key = b.year_key&#xA;WHERE b.company_key IS NULL;&#xA;&#xA;IF @orphan_cnt &gt; 0&#xA;    PRINT 'CẢNH BÁO: Có dòng thiếu match với Bridge!';&#xA;ELSE&#xA;    PRINT 'PASSED: Toàn bộ dòng đều match Bridge.';" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\DQ - Validate ownership bridge_plant_company"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{A91F311A-BDB9-4546-9646-2FBFB049DDA2}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="DQ - Validate ownership bridge_plant_company"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F329DA15-93EA-4CC8-9BA8-C7F4616BC505}"
          SQLTask:SqlStatementSource="-- VALIDATE TỔNG TỶ LỆ SỞ HỮU THEO PLANT (CHUẨN 100%)&#xA;DECLARE @abnormal_plants INT;&#xA;&#xA;SELECT @abnormal_plants = COUNT(*)&#xA;FROM (&#xA;    SELECT year_key, plant_key, SUM(ownership_pct) AS total_pct&#xA;    FROM dbo.bridge_plant_company&#xA;    GROUP BY year_key, plant_key&#xA;    HAVING SUM(ownership_pct) NOT BETWEEN 99.0 AND 100.5&#xA;) t;&#xA;&#xA;IF @abnormal_plants &gt; 0&#xA;    PRINT 'CẢNH BÁO: Có nhà máy có tổng tỷ lệ sở hữu khác 100%!';&#xA;ELSE&#xA;    PRINT 'PASSED: 100% nhà máy có tổng tỷ lệ sở hữu hợp lệ.';" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SCD2 - Merge dim_utility"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{65CFF825-9CC3-484A-B851-569222E7A3EF}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SCD2 - Merge dim_utility"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F329DA15-93EA-4CC8-9BA8-C7F4616BC505}"
          SQLTask:SqlStatementSource="-- 1. ĐÓNG VERSION CŨ KHI CÓ THAY ĐỔI&#xA;UPDATE u&#xA;SET &#xA;    u.effective_to = CAST(GETDATE() AS DATETIME),&#xA;    u.is_current = 0&#xA;FROM dbo.dim_utility u&#xA;INNER JOIN dbo.stg_eia861_sales s &#xA;    ON u.eia_utility_id = TRY_CAST(s.raw_utility_id AS INT)&#xA;WHERE u.is_current = 1&#xA;  AND LTRIM(RTRIM(u.utility_name)) &lt;&gt; LTRIM(RTRIM(s.raw_utility_name));&#xA;&#xA;-- 2. MỞ VERSION MỚI (CHO BẢN GHI ĐỔI TÊN HOẶC MỚI)&#xA;INSERT INTO dbo.dim_utility (&#xA;    eia_utility_id, utility_name, ownership_type, state_key, rto_iso, &#xA;    effective_from, effective_to, is_current&#xA;)&#xA;SELECT DISTINCT&#xA;    TRY_CAST(s.raw_utility_id AS INT) AS eia_utility_id,&#xA;    LTRIM(RTRIM(s.raw_utility_name)) AS utility_name,&#xA;    'Unknown' AS ownership_type,&#xA;    COALESCE(st.state_key, 1) AS state_key,&#xA;    'Unknown' AS rto_iso,&#xA;    CAST(GETDATE() AS DATETIME) AS effective_from,&#xA;    NULL AS effective_to,&#xA;    1 AS is_current&#xA;FROM dbo.stg_eia861_sales s&#xA;LEFT JOIN dbo.dim_state st ON s.raw_state = st.state_code&#xA;WHERE TRY_CAST(s.raw_utility_id AS INT) IS NOT NULL&#xA;  AND NOT EXISTS (&#xA;      SELECT 1 FROM dbo.dim_utility u &#xA;      WHERE u.eia_utility_id = TRY_CAST(s.raw_utility_id AS INT) &#xA;        AND u.is_current = 1&#xA;  );" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
  <DTS:PrecedenceConstraints>
