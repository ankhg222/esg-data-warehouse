                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT
    TRY_CAST(c.raw_oris_code AS INT) AS oris_code,
    TRY_CAST(c.raw_ghgrp_id AS INT) AS ghgrp_facility_id
FROM dbo.stg_oris_crosswalk c
INNER JOIN dbo.stg_ghgrp_facility f
    ON TRY_CAST(c.raw_ghgrp_id AS INT) = TRY_CAST(f.raw_facility_id AS INT)
WHERE TRY_CAST(c.raw_oris_code AS INT) IS NOT NULL 
  AND TRY_CAST(c.raw_ghgrp_id AS INT) IS NOT NULL;</property>
