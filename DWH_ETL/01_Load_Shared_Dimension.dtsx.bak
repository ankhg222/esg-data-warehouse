                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT UPPER(LTRIM(RTRIM(raw_state))) AS state_code
FROM [dbo].[stg_eia861_sales]
WHERE raw_state IS NOT NULL 
  AND LTRIM(RTRIM(raw_state)) &lt;&gt; ''
  AND LEN(LTRIM(RTRIM(raw_state))) = 2;</property>
