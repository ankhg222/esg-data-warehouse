                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT
    LEFT(REPLACE(LTRIM(RTRIM(raw_country_code)), '"', ''), 3) AS country_code,
    LEFT(LTRIM(RTRIM(raw_short_name)), 100) AS country_name,
    LEFT(LTRIM(RTRIM(raw_region)), 100) AS wb_region,
    LEFT(LTRIM(RTRIM(raw_income_group)), 100) AS income_group,
    CASE 
        WHEN raw_region IS NULL OR LTRIM(RTRIM(raw_region)) = '' THEN CAST(1 AS BIT)
        ELSE CAST(0 AS BIT)
    END AS is_aggregate
FROM dbo.stg_esg_country
WHERE raw_country_code IS NOT NULL 
  AND LTRIM(RTRIM(raw_country_code)) &lt;&gt; '';</property>
