        <DTS:Executable
      DTS:refId="Package\DFT - Load dim_utility SCD2"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{8bb9b306-5910-411f-afce-17157a0a106c}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="DFT - Load dim_utility SCD2"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{8BDA3026-F034-43CA-BFC6-D67A438DBE94}"
          SQLTask:SqlStatementSource="-- 1. Dọn dẹp dim_utility cũ nếu cần&#xA;DELETE FROM dbo.dim_utility;&#xA;DBCC CHECKIDENT (&apos;dbo.dim_utility&apos;, RESEED, 0);&#xA;&#xA;-- 2. Nạp dữ liệu dim_utility chuẩn SCD Type 2 từ staging sales&#xA;INSERT INTO dbo.dim_utility (&#xA;    eia_utility_id,&#xA;    utility_name,&#xA;    ownership_type,&#xA;    state_key,&#xA;    rto_iso,&#xA;    effective_from,&#xA;    effective_to,&#xA;    is_current&#xA;)&#xA;SELECT &#xA;    t.eia_utility_id,&#xA;    t.utility_name,&#xA;    &apos;Electric Utility&apos; AS ownership_type,&#xA;    ISNULL(s.state_key, (SELECT TOP 1 state_key FROM dbo.dim_state WHERE state_key IS NOT NULL)) AS state_key,&#xA;    &apos;UNKNOWN&apos; AS rto_iso,&#xA;    CAST(&apos;2018-01-01&apos; AS DATE) AS effective_from,&#xA;    CAST(&apos;9999-12-31&apos; AS DATE) AS effective_to,&#xA;    1 AS is_current&#xA;FROM (&#xA;    SELECT &#xA;        TRY_CAST(raw_utility_id AS INT) AS eia_utility_id,&#xA;        MAX(LTRIM(RTRIM(raw_utility_name))) AS utility_name,&#xA;        MAX(UPPER(LTRIM(RTRIM(raw_state)))) AS state_code&#xA;    FROM dbo.stg_eia861_sales&#xA;    WHERE TRY_CAST(raw_utility_id AS INT) IS NOT NULL&#xA;      AND raw_utility_name IS NOT NULL&#xA;      AND LTRIM(RTRIM(raw_utility_name)) &lt;&gt; &apos;&apos;&#xA;    GROUP BY TRY_CAST(raw_utility_id AS INT)&#xA;) t&#xA;LEFT JOIN dbo.dim_state s ON s.state_code = t.state_code;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Execute SQL Task Load Dim Plant SCD2"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{05B2AEE8-F16B-4BE2-8AB8-0A3E674BC650}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Execute SQL Task Load Dim Plant SCD2"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{8BDA3026-F034-43CA-BFC6-D67A438DBE94}"
          SQLTask:SqlStatementSource="-- 1. Dọn dẹp dim_plant nếu cần chạy lại&#xA;DELETE FROM dbo.dim_plant;&#xA;DBCC CHECKIDENT ('dbo.dim_plant', RESEED, 0);&#xA;&#xA;-- 2. Vòng lặp duyệt qua từng năm (2018 -&gt; 2023) để theo dõi biến động SCD Type 2&#xA;DECLARE @yr INT;&#xA;DECLARE yr_cursor CURSOR FOR &#xA;    SELECT DISTINCT TRY_CAST(raw_year AS INT) &#xA;    FROM dbo.stg_egrid_plant &#xA;    WHERE TRY_CAST(raw_year AS INT) IS NOT NULL &#xA;    ORDER BY TRY_CAST(raw_year AS INT);&#xA;&#xA;OPEN yr_cursor;&#xA;FETCH NEXT FROM yr_cursor INTO @yr;&#xA;&#xA;WHILE @@FETCH_STATUS = 0&#xA;BEGIN&#xA;    -- 2.1. Đóng phiên bản cũ nếu nhà máy có biến động thông tin&#xA;    UPDATE dp&#xA;    SET dp.is_current = 0,&#xA;        dp.effective_to = DATEFROMPARTS(@yr, 1, 1)&#xA;    FROM dbo.dim_plant dp&#xA;    JOIN (&#xA;        SELECT &#xA;            TRY_CAST(s.raw_oris_code AS INT) AS oris_code,&#xA;            s.raw_plant_name AS plant_name,&#xA;            s.raw_operator_name AS operator_name,&#xA;            f.fuel_key AS primary_fuel_key,&#xA;            st.state_key AS state_key,&#xA;            ba.ba_key AS ba_key,&#xA;            s.raw_subregion AS egrid_subregion,&#xA;            TRY_CAST(s.raw_capacity_mw AS DECIMAL(10,2)) AS nameplate_capacity_mw&#xA;        FROM dbo.stg_egrid_plant s&#xA;        LEFT JOIN dbo.dim_fuel f ON f.fuel_code = s.raw_primary_fuel&#xA;        LEFT JOIN dbo.dim_state st ON st.state_code = s.raw_state&#xA;        LEFT JOIN dbo.dim_ba ba ON ba.ba_code = s.raw_ba_code&#xA;        WHERE s.raw_year = CAST(@yr AS VARCHAR(10))&#xA;          AND TRY_CAST(s.raw_oris_code AS INT) IS NOT NULL&#xA;    ) new_data ON new_data.oris_code = dp.oris_code AND dp.is_current = 1&#xA;    WHERE ISNULL(dp.operator_name, '') &lt;&gt; ISNULL(new_data.operator_name, '')&#xA;       OR ISNULL(dp.primary_fuel_key, -1) &lt;&gt; ISNULL(new_data.primary_fuel_key, -1)&#xA;       OR ISNULL(dp.nameplate_capacity_mw, -1) &lt;&gt; ISNULL(new_data.nameplate_capacity_mw, -1)&#xA;       OR ISNULL(dp.ba_key, -1) &lt;&gt; ISNULL(new_data.ba_key, -1)&#xA;       OR ISNULL(dp.egrid_subregion, '') &lt;&gt; ISNULL(new_data.egrid_subregion, '');&#xA;&#xA;    -- 2.2. Thêm phiên bản mới (nhà máy mới xuất hiện HOẶC phiên bản mới vừa đổi thông tin)&#xA;    INSERT INTO dbo.dim_plant (&#xA;        oris_code, plant_name, operator_name, primary_fuel_key,&#xA;        state_key, ba_key, egrid_subregion, nameplate_capacity_mw,&#xA;        effective_from, effective_to, is_current&#xA;    )&#xA;    SELECT &#xA;        new_data.oris_code,&#xA;        new_data.plant_name,&#xA;        new_data.operator_name,&#xA;        new_data.primary_fuel_key,&#xA;        new_data.state_key,&#xA;        new_data.ba_key,&#xA;        new_data.egrid_subregion,&#xA;        new_data.nameplate_capacity_mw,&#xA;        DATEFROMPARTS(@yr, 1, 1) AS effective_from,&#xA;        '9999-12-31' AS effective_to,&#xA;        1 AS is_current&#xA;    FROM (&#xA;        SELECT &#xA;            TRY_CAST(s.raw_oris_code AS INT) AS oris_code,&#xA;            MAX(s.raw_plant_name) AS plant_name,&#xA;            MAX(s.raw_operator_name) AS operator_name,&#xA;            MAX(f.fuel_key) AS primary_fuel_key,&#xA;            MAX(st.state_key) AS state_key,&#xA;            MAX(ba.ba_key) AS ba_key,&#xA;            MAX(s.raw_subregion) AS egrid_subregion,&#xA;            MAX(TRY_CAST(s.raw_capacity_mw AS DECIMAL(10,2))) AS nameplate_capacity_mw&#xA;        FROM dbo.stg_egrid_plant s&#xA;        LEFT JOIN dbo.dim_fuel f ON f.fuel_code = s.raw_primary_fuel&#xA;        LEFT JOIN dbo.dim_state st ON st.state_code = s.raw_state&#xA;        LEFT JOIN dbo.dim_ba ba ON ba.ba_code = s.raw_ba_code&#xA;        WHERE s.raw_year = CAST(@yr AS VARCHAR(10))&#xA;          AND TRY_CAST(s.raw_oris_code AS INT) IS NOT NULL&#xA;        GROUP BY TRY_CAST(s.raw_oris_code AS INT)&#xA;    ) new_data&#xA;    WHERE NOT EXISTS (&#xA;        SELECT 1 FROM dbo.dim_plant dp &#xA;        WHERE dp.oris_code = new_data.oris_code AND dp.is_current = 1&#xA;    );&#xA;&#xA;    FETCH NEXT FROM yr_cursor INTO @yr;&#xA;END;&#xA;&#xA;CLOSE yr_cursor;&#xA;DEALLOCATE yr_cursor;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Sync Remaining Fuels From 5-Year Staging"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{B3031DA4-972E-40F7-B0CE-29AB99818479}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Sync Remaining Fuels From 5-Year Staging"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{8BDA3026-F034-43CA-BFC6-D67A438DBE94}"
          SQLTask:SqlStatementSource="-- Tự động quét 5 năm Staging để bổ sung bất kỳ mã nhiên liệu nào chưa có trong dim_fuel&#xA;INSERT INTO dbo.dim_fuel (fuel_code, fuel_name, fuel_category, is_fossil, is_renewable)&#xA;SELECT DISTINCT &#xA;    stg.f_code,&#xA;    -- Gán tên mô tả cho các mã thực tế phát sinh&#xA;    CASE stg.f_code&#xA;        WHEN 'COG' THEN 'Coke Oven Gas'&#xA;        WHEN 'PRG' THEN 'Process Gas'&#xA;        WHEN 'MSW' THEN 'Municipal Solid Waste'&#xA;        WHEN 'H2'  THEN 'Hydrogen Fuel'&#xA;        ELSE 'Fuel Code ' + stg.f_code&#xA;    END AS fuel_name,&#xA;    -- Phân loại nhóm&#xA;    CASE &#xA;        WHEN stg.f_code IN ('COG', 'PRG') THEN 'Fossil'&#xA;        WHEN stg.f_code IN ('H2') THEN 'Renewable'&#xA;        ELSE 'Other'&#xA;    END AS fuel_category,&#xA;    -- Cờ hóa thạch&#xA;    CASE WHEN stg.f_code IN ('COG', 'PRG') THEN 1 ELSE 0 END AS is_fossil,&#xA;    -- Cờ tái tạo&#xA;    CASE WHEN stg.f_code IN ('H2') THEN 1 ELSE 0 END AS is_renewable&#xA;FROM (&#xA;    -- Quét toàn bộ 5 năm của eGRID Plant&#xA;    SELECT DISTINCT raw_primary_fuel AS f_code &#xA;    FROM dbo.stg_egrid_plant &#xA;    WHERE raw_primary_fuel IS NOT NULL &#xA;      AND raw_primary_fuel &lt;&gt; '' &#xA;      AND raw_primary_fuel &lt;&gt; 'PLPRMFL'&#xA;    UNION&#xA;    -- Quét toàn bộ 5 năm của EIA-923 Generation&#xA;    SELECT DISTINCT raw_fuel_code AS f_code &#xA;    FROM dbo.stg_eia923_generation &#xA;    WHERE raw_fuel_code IS NOT NULL &#xA;      AND raw_fuel_code &lt;&gt; ''&#xA;      AND raw_fuel_code &lt;&gt; 'Reported_Fuel Type Code'&#xA;) stg&#xA;WHERE stg.f_code NOT IN (SELECT fuel_code FROM dbo.dim_fuel);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
