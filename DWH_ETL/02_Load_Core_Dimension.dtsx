              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH CombinedCompanies AS (
    -- Nguồn 1: Sustainalytics ESG (Có Ticker và Tên công ty)
    SELECT 
        LEFT(UPPER(LTRIM(RTRIM(REPLACE(raw_company_name, '"', '')))), 200) AS company_name_std,
        LEFT(LTRIM(RTRIM(REPLACE(raw_ticker, '"', ''))), 10) AS ticker
    FROM dbo.stg_sustainalytics_esg
    WHERE raw_company_name IS NOT NULL 
      AND LTRIM(RTRIM(raw_company_name)) &lt;&gt; ''
      AND LTRIM(RTRIM(raw_company_name)) &lt;&gt; 'N/A'
    
    UNION ALL
    
    -- Nguồn 2: GHGRP Parent Company (Phục vụ cho Bridge Plant Company)
    SELECT 
        LEFT(UPPER(LTRIM(RTRIM(REPLACE(raw_parent_name, '"', '')))), 200) AS company_name_std,
        CAST(NULL AS VARCHAR(10)) AS ticker
    FROM dbo.stg_ghgrp_parent_company
    WHERE raw_parent_name IS NOT NULL 
      AND LTRIM(RTRIM(REPLACE(raw_parent_name, '"', ''))) &lt;&gt; ''
      AND LTRIM(RTRIM(REPLACE(raw_parent_name, '"', ''))) &lt;&gt; 'N/A'
)
SELECT 
    cc.company_name_std,
    MAX(cc.ticker) AS ticker,
    (SELECT TOP 1 country_key FROM dbo.dim_country WHERE country_code = 'USA') AS country_key
FROM CombinedCompanies cc
GROUP BY cc.company_name_std;</property>
