  <DTS:Variables />
  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\DQ - Reconciliation fact_plant_annual"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{78225708-7187-4220-96CB-AB82D6E6157A}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="DQ - Reconciliation fact_plant_annual"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9C983A6A-8C21-40CD-9162-5A77E4193F91}"
          SQLTask:SqlStatementSource="DECLARE @StgCount INT, @FactCount INT, @DirtyCount INT;&#xA;DECLARE @OrphanPlantCount INT = 0, @OrphanYearCount INT = 0;&#xA;DECLARE @NegativeCO2Count INT = 0;&#xA;&#xA;-- 1. Đối soát số dòng (Reconciliation)&#xA;SELECT @StgCount = COUNT(*) FROM dbo.stg_egrid_plant;&#xA;SELECT @FactCount = COUNT(*) FROM dbo.fact_plant_annual;&#xA;SELECT @DirtyCount = COUNT(*) FROM dbo.stg_egrid_plant WHERE TRY_CAST(raw_oris_code AS INT) IS NULL OR TRY_CAST(raw_year AS INT) IS NULL;&#xA;&#xA;IF (@StgCount - @DirtyCount) &lt;&gt; @FactCount&#xA;BEGIN&#xA;    DECLARE @MsgRecon NVARCHAR(2048) = FORMATMESSAGE('DQ ERROR: Doi soat so dong that bai! Staging: %d, Dirty: %d, Fact: %d', @StgCount, @DirtyCount, @FactCount);&#xA;    THROW 52005, @MsgRecon, 1;&#xA;END;&#xA;&#xA;-- 2. Kiểm tra Orphan Plant Keys&#xA;SELECT @OrphanPlantCount = COUNT(*)&#xA;FROM dbo.fact_plant_annual f&#xA;LEFT JOIN dbo.dim_plant p ON f.plant_key = p.plant_key&#xA;WHERE p.plant_key IS NULL;&#xA;&#xA;IF @OrphanPlantCount &gt; 0&#xA;BEGIN&#xA;    DECLARE @MsgPlant NVARCHAR(2048) = FORMATMESSAGE('DQ ERROR: Phat hien %d dong Fact co plant_key mo coi!', @OrphanPlantCount);&#xA;    THROW 52006, @MsgPlant, 1;&#xA;END;&#xA;&#xA;-- 3. Kiểm tra Orphan Year Keys&#xA;SELECT @OrphanYearCount = COUNT(*)&#xA;FROM dbo.fact_plant_annual f&#xA;LEFT JOIN dbo.dim_date d ON f.year_key = d.date_key&#xA;WHERE d.date_key IS NULL;&#xA;&#xA;IF @OrphanYearCount &gt; 0&#xA;BEGIN&#xA;    DECLARE @MsgYear NVARCHAR(2048) = FORMATMESSAGE('DQ ERROR: Phat hien %d dong Fact co year_key mo coi!', @OrphanYearCount);&#xA;    THROW 52007, @MsgYear, 1;&#xA;END;&#xA;&#xA;-- 4. Kiểm tra phát thải âm bất thường&#xA;SELECT @NegativeCO2Count = COUNT(*)&#xA;FROM dbo.fact_plant_annual&#xA;WHERE co2_annual &lt; 0;&#xA;&#xA;IF @NegativeCO2Count &gt; 0&#xA;BEGIN&#xA;    DECLARE @MsgCO2 NVARCHAR(2048) = FORMATMESSAGE('DQ ERROR: Phat hien %d ban ghi co phat thai CO2 &lt; 0!', @NegativeCO2Count);&#xA;    THROW 52008, @MsgCO2, 1;&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\DQ - Validate bridge_plant_ghgrp_facility"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{BF2BC774-9BA0-48AD-8371-04E770B3EA63}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="DQ - Validate bridge_plant_ghgrp_facility"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9C983A6A-8C21-40CD-9162-5A77E4193F91}"
          SQLTask:SqlStatementSource="DECLARE @NullMappingCount INT = 0;&#xA;DECLARE @TotalBridgeRows INT = 0;&#xA;&#xA;-- 1. Kiểm tra không có cặp mapping nào bị NULL khóa&#xA;SELECT @NullMappingCount = COUNT(*)&#xA;FROM dbo.bridge_plant_ghgrp_facility&#xA;WHERE oris_code IS NULL OR ghgrp_facility_id IS NULL;&#xA;&#xA;IF @NullMappingCount &gt; 0&#xA;BEGIN&#xA;    DECLARE @MsgNull NVARCHAR(2048) = FORMATMESSAGE('DQ ERROR: Phat hien %d cap mapping bi NULL khoa trong bridge_plant_ghgrp_facility!', @NullMappingCount);&#xA;    THROW 52009, @MsgNull, 1;&#xA;END;&#xA;&#xA;-- 2. Kiểm tra bảng bridge không bị rỗng&#xA;SELECT @TotalBridgeRows = COUNT(*) FROM dbo.bridge_plant_ghgrp_facility;&#xA;&#xA;IF @TotalBridgeRows = 0&#xA;BEGIN&#xA;    THROW 52010, 'DQ ERROR: Bang bridge_plant_ghgrp_facility bi rong (0 dong)!', 1;&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SCD1 - UPSERT dim_parent_company"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{AB5FAFC4-9977-4A3F-90BA-95891B6AECB3}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SCD1 - UPSERT dim_parent_company"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9C983A6A-8C21-40CD-9162-5A77E4193F91}"
          SQLTask:SqlStatementSource="-- 1. Thực thi MERGE ghi đè SCD Type 1&#xA;WITH SourceCompanies AS (&#xA;    SELECT &#xA;        LEFT(UPPER(LTRIM(RTRIM(REPLACE(raw_company_name, '&quot;', '')))), 200) AS company_name_std,&#xA;        LEFT(LTRIM(RTRIM(REPLACE(raw_ticker, '&quot;', ''))), 10) AS ticker&#xA;    FROM dbo.stg_sustainalytics_esg&#xA;    WHERE raw_company_name IS NOT NULL &#xA;      AND LTRIM(RTRIM(raw_company_name)) &lt;&gt; ''&#xA;      AND LTRIM(RTRIM(raw_company_name)) &lt;&gt; 'N/A'&#xA;    UNION ALL&#xA;    SELECT &#xA;        LEFT(UPPER(LTRIM(RTRIM(REPLACE(raw_parent_name, '&quot;', '')))), 200) AS company_name_std,&#xA;        CAST(NULL AS VARCHAR(10)) AS ticker&#xA;    FROM dbo.stg_ghgrp_parent_company&#xA;    WHERE raw_parent_name IS NOT NULL &#xA;      AND LTRIM(RTRIM(REPLACE(raw_parent_name, '&quot;', ''))) &lt;&gt; ''&#xA;      AND LTRIM(RTRIM(REPLACE(raw_parent_name, '&quot;', ''))) &lt;&gt; 'N/A'&#xA;),&#xA;CleanSource AS (&#xA;    SELECT &#xA;        sc.company_name_std,&#xA;        MAX(sc.ticker) AS ticker,&#xA;        (SELECT TOP 1 country_key FROM dbo.dim_country WHERE country_code = 'USA') AS country_key&#xA;    FROM SourceCompanies sc&#xA;    GROUP BY sc.company_name_std&#xA;)&#xA;MERGE INTO dbo.dim_parent_company AS target&#xA;USING CleanSource AS src&#xA;ON (target.company_name_std = src.company_name_std)&#xA;WHEN MATCHED AND (&#xA;    ISNULL(target.ticker, '') &lt;&gt; ISNULL(src.ticker, '')&#xA;    OR ISNULL(target.country_key, -1) &lt;&gt; ISNULL(src.country_key, -1)&#xA;) THEN &#xA;    UPDATE SET &#xA;        target.ticker = src.ticker,&#xA;        target.country_key = src.country_key&#xA;WHEN NOT MATCHED BY TARGET THEN&#xA;    INSERT (company_name_std, ticker, country_key)&#xA;    VALUES (src.company_name_std, src.ticker, src.country_key);&#xA;&#xA;-- 2. Chốt chặn: Kiểm tra nếu bị nhân bản tên công ty thì báo lỗi&#xA;DECLARE @DupCompanyCount INT = 0;&#xA;SELECT @DupCompanyCount = COUNT(*)&#xA;FROM (&#xA;    SELECT company_name_std &#xA;    FROM dbo.dim_parent_company &#xA;    GROUP BY company_name_std &#xA;    HAVING COUNT(*) &gt; 1&#xA;) t;&#xA;&#xA;IF @DupCompanyCount &gt; 0&#xA;BEGIN&#xA;    DECLARE @Msg NVARCHAR(2048) = FORMATMESSAGE('SCD1 ERROR: Phat hien %d cong ty bi trung lap ten sau khi MERGE!', @DupCompanyCount);&#xA;    THROW 52004, @Msg, 1;&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SCD2 - Validate dim_plant"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{DB972C97-61E1-46C2-98C5-E82F936FCCE3}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SCD2 - Validate dim_plant"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9C983A6A-8C21-40CD-9162-5A77E4193F91}"
          SQLTask:SqlStatementSource="DECLARE @DupActiveCount INT = 0;&#xA;DECLARE @InvalidEndDateCount INT = 0;&#xA;DECLARE @TimeGapOverlapCount INT = 0;&#xA;&#xA;-- 1. Kiểm tra 1 nhà máy có nhiều hơn 1 bản ghi active&#xA;SELECT @DupActiveCount = COUNT(*)&#xA;FROM (&#xA;    SELECT oris_code &#xA;    FROM dbo.dim_plant &#xA;    WHERE is_current = 1 &#xA;    GROUP BY oris_code &#xA;    HAVING COUNT(*) &gt; 1&#xA;) t;&#xA;&#xA;IF @DupActiveCount &gt; 0&#xA;BEGIN&#xA;    DECLARE @Msg1 NVARCHAR(2048) = FORMATMESSAGE('SCD2 ERROR: Phat hien %d nha may co hon 1 ban ghi active (is_current=1) trong dim_plant!', @DupActiveCount);&#xA;    THROW 52001, @Msg1, 1;&#xA;END;&#xA;&#xA;-- 2. Kiểm tra bản ghi active có effective_to chuẩn 9999-12-31 (bắt cả lỗi NULL)&#xA;SELECT @InvalidEndDateCount = COUNT(*)&#xA;FROM dbo.dim_plant&#xA;WHERE is_current = 1 AND (effective_to IS NULL OR effective_to &lt;&gt; '9999-12-31');&#xA;&#xA;IF @InvalidEndDateCount &gt; 0&#xA;BEGIN&#xA;    DECLARE @Msg2 NVARCHAR(2048) = FORMATMESSAGE('SCD2 ERROR: Phat hien %d ban ghi active co effective_to khong phai 9999-12-31 (hoac bi NULL)!', @InvalidEndDateCount);&#xA;    THROW 52002, @Msg2, 1;&#xA;END;&#xA;&#xA;-- 3. Kiểm tra tính liền mạch thời gian (Không bị gap hay overlap giữa các version)&#xA;WITH PlantVersions AS (&#xA;    SELECT &#xA;        oris_code,&#xA;        effective_from,&#xA;        effective_to,&#xA;        LEAD(effective_from) OVER (PARTITION BY oris_code ORDER BY effective_from) AS next_effective_from&#xA;    FROM dbo.dim_plant&#xA;)&#xA;SELECT @TimeGapOverlapCount = COUNT(*)&#xA;FROM PlantVersions&#xA;WHERE next_effective_from IS NOT NULL AND effective_to &lt;&gt; next_effective_from;&#xA;&#xA;IF @TimeGapOverlapCount &gt; 0&#xA;BEGIN&#xA;    DECLARE @Msg3 NVARCHAR(2048) = FORMATMESSAGE('SCD2 ERROR: Phat hien %d vi pham gian doan/chong lan thoi gian trong dim_plant!', @TimeGapOverlapCount);&#xA;    THROW 52003, @Msg3, 1;&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
