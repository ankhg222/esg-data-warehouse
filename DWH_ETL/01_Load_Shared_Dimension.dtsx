    <DTS:Executable
      DTS:refId="Package\Execute SQL Task Populate Dim Date &amp; Hour"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{8B0B79D7-9461-469C-BC56-A19CCB1967CB}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Execute SQL Task Populate Dim Date &amp; Hour"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9C983A6A-8C21-40CD-9162-5A77E4193F91}"
          SQLTask:SqlStatementSource="&#xA;DELETE FROM dbo.dim_hour;&#xA;DELETE FROM dbo.dim_date;&#xA;&#xA;&#xA;WITH DateRange AS (&#xA;    SELECT CAST('2018-01-01' AS DATE) AS d&#xA;    UNION ALL&#xA;    SELECT DATEADD(DAY, 1, d)&#xA;    FROM DateRange&#xA;    WHERE d &lt; '2023-12-31'&#xA;)&#xA;INSERT INTO dbo.dim_date (date_key, full_date, year, quarter, month, day, day_of_week, is_weekend)&#xA;SELECT &#xA;    YEAR(d) * 10000 + MONTH(d) * 100 + DAY(d) AS date_key,&#xA;    d AS full_date,&#xA;    YEAR(d) AS year,&#xA;    DATEPART(QUARTER, d) AS quarter,&#xA;    MONTH(d) AS month,&#xA;    DAY(d) AS day,&#xA;    DATEPART(WEEKDAY, d) AS day_of_week,&#xA;    CASE WHEN DATEPART(WEEKDAY, d) IN (1, 7) THEN 1 ELSE 0 END AS is_weekend&#xA;FROM DateRange&#xA;OPTION (MAXRECURSION 3000);&#xA;&#xA;&#xA;INSERT INTO dbo.dim_hour (hour_key, date_key, hour_utc, local_datetime_eastern, is_peak_hour)&#xA;SELECT &#xA;    d.date_key * 100 + h.hr AS hour_key,&#xA;    d.date_key,&#xA;    h.hr AS hour_utc,&#xA;    DATEADD(HOUR, h.hr - 5, CAST(d.full_date AS DATETIME)) AS local_datetime_eastern,&#xA;    CASE &#xA;        WHEN d.is_weekend = 0 AND h.hr BETWEEN 7 AND 22 THEN 1 &#xA;        ELSE 0 &#xA;    END AS is_peak_hour&#xA;FROM dbo.dim_date d&#xA;CROSS JOIN (&#xA;    SELECT 0 AS hr UNION ALL SELECT 1 UNION ALL SELECT 2 UNION ALL SELECT 3&#xA;    UNION ALL SELECT 4 UNION ALL SELECT 5 UNION ALL SELECT 6 UNION ALL SELECT 7&#xA;    UNION ALL SELECT 8 UNION ALL SELECT 9 UNION ALL SELECT 10 UNION ALL SELECT 11&#xA;    UNION ALL SELECT 12 UNION ALL SELECT 13 UNION ALL SELECT 14 UNION ALL SELECT 15&#xA;    UNION ALL SELECT 16 UNION ALL SELECT 17 UNION ALL SELECT 18 UNION ALL SELECT 19&#xA;    UNION ALL SELECT 20 UNION ALL SELECT 21 UNION ALL SELECT 22 UNION ALL SELECT 23&#xA;) h;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
