            <component
              refId="Package\DFT - Load fact_company_esg_rating\SRC - Sustainalytics ESG"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="SRC - Sustainalytics ESG"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH CleanESG AS (
    SELECT 
        -- Xử lý an toàn cả định dạng YYYY-MM-DD và YYYYMMDD
        COALESCE(
            TRY_CAST(REPLACE(LTRIM(RTRIM(s.raw_date)), '"', '') AS INT),
            TRY_CAST(REPLACE(CONVERT(VARCHAR(10), TRY_CAST(REPLACE(LTRIM(RTRIM(s.raw_date)), '"', '') AS DATE), 120), '-', '') AS INT)
        ) AS r_date_key,
        LEFT(UPPER(LTRIM(RTRIM(REPLACE(s.raw_company_name, '"', '')))), 200) AS r_company_name,
        TRY_CAST(REPLACE(s.raw_total_esg_score, '"', '') AS DECIMAL(6,2)) AS r_total_esg,
        TRY_CAST(REPLACE(s.raw_environment_score, '"', '') AS DECIMAL(6,2)) AS r_env,
        TRY_CAST(REPLACE(s.raw_social_score, '"', '') AS DECIMAL(6,2)) AS r_soc,
        TRY_CAST(REPLACE(s.raw_governance_score, '"', '') AS DECIMAL(6,2)) AS r_gov
    FROM dbo.stg_sustainalytics_esg s
    WHERE s.raw_date IS NOT NULL 
      AND s.raw_company_name IS NOT NULL
)
SELECT 
    d.date_key AS rating_date_key,
    c.company_key,
    (SELECT TOP 1 source_key FROM dbo.dim_data_source WHERE source_code = 'SUSTAINALYTICS') AS source_key,
    ROUND(AVG(s.r_total_esg), 2) AS total_esg_score,
    ROUND(AVG(s.r_env), 2) AS environment_score,
    ROUND(AVG(s.r_soc), 2) AS social_score,
    ROUND(AVG(s.r_gov), 2) AS governance_score
FROM CleanESG s
INNER JOIN dbo.dim_parent_company c 
    ON s.r_company_name = c.company_name_std
INNER JOIN dbo.dim_date d 
    ON d.date_key = s.r_date_key
WHERE s.r_date_key IS NOT NULL
GROUP BY 
    d.date_key,
    c.company_key;</property>
